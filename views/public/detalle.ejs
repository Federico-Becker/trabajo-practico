<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../partials/navbar') -%>

  <main class="container detail-page">
    <a class="back-link" href="/">&larr; Volver al catálogo</a>

    <div class="detail-layout">
      <section class="detail-gallery">
        <% if (imagenes.length) { %>
          <div class="detail-main-image">
            <img src="<%= imagenes[0].url %>" alt="<%= vehiculo.marca %> <%= vehiculo.modelo %>">
          </div>
          <% if (imagenes.length > 1) { %>
            <div class="detail-thumbs">
              <% imagenes.forEach(function (imagen) { %>
                <img src="<%= imagen.url %>" alt="Vista del vehículo">
              <% }); %>
            </div>
          <% } %>
        <% } else { %>
          <div class="detail-main-image detail-placeholder"><span>Sin imágenes cargadas</span></div>
        <% } %>
      </section>

      <section class="detail-info">
        <span class="tag"><%= vehiculo.marca %> · <%= vehiculo.categoria %></span>
        <h1><%= vehiculo.modelo %></h1>
        <p class="detail-price"><%= formatearMoneda(vehiculo.precio) %></p>
        <p class="detail-description"><%= vehiculo.descripcion || 'Vehículo en excelente estado. Consultanos por más detalles.' %></p>

        <div class="spec-grid">
          <div><span>Año</span><strong><%= vehiculo.anio %></strong></div>
          <div><span>Kilometraje</span><strong><%= vehiculo.kilometraje.toLocaleString('es-AR') %> km</strong></div>
          <div><span>Combustible</span><strong><%= vehiculo.combustible %></strong></div>
          <div><span>Transmisión</span><strong><%= vehiculo.transmision %></strong></div>
          <div><span>Color</span><strong><%= vehiculo.color || 'No especificado' %></strong></div>
          <div><span>Estado</span><strong class="badge badge-disponible"><%= vehiculo.estado %></strong></div>
        </div>
      </section>
    </div>

    <section class="panel contact-panel">
      <h2>Consultar por este vehículo</h2>
      <p>Completá el formulario y nos pondremos en contacto con vos a la brevedad.</p>
      <form action="/consultas" method="POST" class="form-grid">
        <input type="hidden" name="vehiculo_id" value="<%= vehiculo.id %>">
        <label>
          <span>Nombre *</span>
          <input type="text" name="nombre" required placeholder="Tu nombre">
        </label>
        <label>
          <span>Email *</span>
          <input type="email" name="email" required placeholder="tu@email.com">
        </label>
        <label>
          <span>Teléfono</span>
          <input type="tel" name="telefono" placeholder="261 555 5555">
        </label>
        <label class="full-width">
          <span>Mensaje *</span>
          <textarea name="mensaje" rows="4" required placeholder="Escribí tu consulta..."></textarea>
        </label>
        <div class="full-width">
          <button type="submit" class="btn btn-primary">Enviar consulta</button>
        </div>
      </form>
    </section>
  </main>
</body>
</html>

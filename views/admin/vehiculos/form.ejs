<%
  function seleccionado(actual, opcion) {
    return String(actual) === String(opcion) ? 'selected' : '';
  }
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../../partials/navbar') -%>

  <main class="container admin-page">
    <a class="back-link" href="/admin/vehiculos">&larr; Volver a vehículos</a>

    <div class="page-heading">
      <div>
        <p class="eyebrow">Administración</p>
        <h1><%= editando ? 'Editar vehículo' : 'Nuevo vehículo' %></h1>
        <p class="muted">Completá los datos principales y cargá las imágenes del vehículo.</p>
      </div>
    </div>

    <form action="<%= action %>" method="POST" enctype="multipart/form-data">
      <section class="panel">
        <h2>Datos del vehículo</h2>
        <div class="form-grid">
          <label>
            <span>Marca *</span>
            <select name="marca_id" required>
              <option value="">Seleccionar</option>
              <% marcas.forEach(function (marca) { %>
                <option value="<%= marca.id %>" <%= vehiculo ? seleccionado(vehiculo.marca_id, marca.id) : '' %>><%= marca.nombre %></option>
              <% }); %>
            </select>
          </label>
          <label>
            <span>Categoría *</span>
            <select name="categoria_id" required>
              <option value="">Seleccionar</option>
              <% categorias.forEach(function (categoria) { %>
                <option value="<%= categoria.id %>" <%= vehiculo ? seleccionado(vehiculo.categoria_id, categoria.id) : '' %>><%= categoria.nombre %></option>
              <% }); %>
            </select>
          </label>
          <label>
            <span>Modelo *</span>
            <input type="text" name="modelo" required value="<%= vehiculo ? vehiculo.modelo : '' %>" placeholder="Ej: Corolla XEi">
          </label>
          <label>
            <span>Año *</span>
            <input type="number" name="anio" min="1900" max="2100" required value="<%= vehiculo ? vehiculo.anio : '' %>">
          </label>
          <label>
            <span>Precio *</span>
            <input type="number" name="precio" min="0" step="1000" required value="<%= vehiculo ? vehiculo.precio : '' %>">
          </label>
          <label>
            <span>Kilometraje</span>
            <input type="number" name="kilometraje" min="0" step="1" value="<%= vehiculo ? vehiculo.kilometraje : 0 %>">
          </label>
          <label>
            <span>Combustible *</span>
            <select name="combustible" required>
              <option value="">Seleccionar</option>
              <% combustibles.forEach(function (combustible) { %>
                <option value="<%= combustible %>" <%= vehiculo ? seleccionado(vehiculo.combustible, combustible) : '' %>><%= combustible %></option>
              <% }); %>
            </select>
          </label>
          <label>
            <span>Transmisión *</span>
            <select name="transmision" required>
              <option value="">Seleccionar</option>
              <% transmisiones.forEach(function (transmision) { %>
                <option value="<%= transmision %>" <%= vehiculo ? seleccionado(vehiculo.transmision, transmision) : '' %>><%= transmision %></option>
              <% }); %>
            </select>
          </label>
          <label>
            <span>Color</span>
            <input type="text" name="color" value="<%= vehiculo && vehiculo.color ? vehiculo.color : '' %>" placeholder="Ej: Gris">
          </label>
          <label>
            <span>Estado *</span>
            <select name="estado" required>
              <% estados.forEach(function (estado) { %>
                <option value="<%= estado %>" <%= vehiculo ? seleccionado(vehiculo.estado, estado) : '' %>><%= estado %></option>
              <% }); %>
            </select>
          </label>
          <label class="full-width">
            <span>Descripción</span>
            <textarea name="descripcion" rows="4" placeholder="Detalles del vehículo..."><%= vehiculo && vehiculo.descripcion ? vehiculo.descripcion : '' %></textarea>
          </label>
          <label class="checkbox-label full-width">
            <input type="checkbox" name="destacado" value="1" <%= vehiculo && vehiculo.destacado ? 'checked' : '' %>>
            <span>Destacar este vehículo en el catálogo</span>
          </label>
        </div>
      </section>

      <section class="panel">
        <div class="panel-heading">
          <h2>Imágenes</h2>
          <span class="muted">Exterior, interior y detalles</span>
        </div>
        <% if (editando && imagenes.length) { %>
          <div class="image-preview-grid">
            <% imagenes.forEach(function (imagen) { %>
              <div class="image-preview">
                <img src="<%= imagen.url %>" alt="Imagen del vehículo">
                <span class="image-tipo"><%= imagen.tipo === 'interior' ? 'Interior' : imagen.tipo === 'detalle' ? 'Detalle' : 'Exterior' %></span>
                <label class="checkbox-label">
                  <input type="checkbox" name="imagenes_eliminar" value="<%= imagen.id %>">
                  <span>Eliminar</span>
                </label>
              </div>
            <% }); %>
          </div>
        <% } %>
        <label class="upload-zone">
          <span>Agregar imágenes</span>
          <input type="file" name="imagenes" accept="image/jpeg,image/png,image/webp" multiple>
        </label>
        <label class="upload-tipo">
          <span>Tipo de las imágenes nuevas</span>
          <select name="tipo_imagen">
            <% tiposImagen.forEach(function (tipo) { %>
              <option value="<%= tipo %>"><%= tipo === 'interior' ? 'Interior' : tipo === 'detalle' ? 'Detalle' : 'Exterior' %></option>
            <% }); %>
          </select>
        </label>
        <p class="upload-note">Formatos: JPG, JPEG, PNG o WEBP. Máximo 5 MB por imagen y hasta 8 imágenes.</p>
      </section>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= editando ? 'Guardar cambios' : 'Crear vehículo' %></button>
        <a class="btn btn-ghost" href="/admin/vehiculos">Cancelar</a>
      </div>
    </form>
  </main>
  <%- include('../../partials/footer') -%>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../../partials/navbar') -%>

  <main class="container admin-page">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Administración</p>
        <h1>Marcas</h1>
        <p class="muted"> Alta, edición y eliminación de marcas.</p>
      </div>
    </div>

    <section class="panel">
      <h2>Agregar marca</h2>
      <form action="/admin/marcas" method="POST" class="inline-form">
        <input type="text" name="nombre" required placeholder="Nombre de la marca">
        <button type="submit" class="btn btn-primary">Agregar</button>
      </form>
    </section>

    <section class="panel">
      <% if (marcas.length) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Nombre</th><th>Vehículos</th><th>Acciones</th></tr>
            </thead>
            <tbody>
              <% marcas.forEach(function (marca) { %>
                <tr>
                  <td><strong><%= marca.nombre %></strong></td>
                  <td><%= marca.total_vehiculos %></td>
                  <td>
                    <div class="table-actions">
                      <form action="/admin/marcas/<%= marca.id %>/actualizar" method="POST" class="inline-form">
                        <input type="text" name="nombre" value="<%= marca.nombre %>" required class="input-small">
                        <button type="submit" class="btn btn-ghost btn-small">Guardar</button>
                      </form>
                      <form action="/admin/marcas/<%= marca.id %>/eliminar" method="POST" class="inline-form" onsubmit="return confirm('¿Eliminar esta marca?');">
                        <button type="submit" class="btn btn-danger btn-small">Eliminar</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted">Todavía no hay marcas cargadas.</p>
      <% } %>
    </section>
  </main>
</body>
</html>
